diff --git a/packages/tui/src/component/dialog-about.tsx b/packages/tui/src/component/dialog-about.tsx
new file mode 100644
--- /dev/null
+++ b/packages/tui/src/component/dialog-about.tsx
@@ -0,0 +1,26 @@
+import { PRODUCT_NAME, PRODUCT_VERSION } from "@opencode-ai/core/branding"
+import { InstallationVersion } from "@opencode-ai/core/installation/version"
+import { createMemo } from "solid-js"
+import { useLocal } from "../context/local"
+import { useSync } from "../context/sync"
+import { DialogAlert } from "../ui/dialog-alert"
+
+export function DialogAbout() {
+  const local = useLocal()
+  const sync = useSync()
+  const message = createMemo(() => {
+    const model = local.model.current()
+    const provider = sync.data.provider.find((item) => item.id === model?.providerID)
+    return [
+      `${PRODUCT_NAME} ${PRODUCT_VERSION}`,
+      "苏州迅驰信息科技有限公司 · 集成电路设计助手",
+      "Suzhou Xunchi Information Technology Co., Ltd",
+      `基于 OpenCode ${InstallationVersion} · 上游许可证：MIT`,
+      "启动命令：xunchi-agent-centos7",
+      `当前服务商：${provider?.name ?? model?.providerID ?? "未选择"}`,
+      `当前模型：${model ? `${model.providerID}/${model.modelID}` : "未选择"}`,
+      "模型与服务商由现有配置决定。工具能力以当前会话连接状态为准。",
+    ].join("\n")
+  })
+  return <DialogAlert title={`关于 ${PRODUCT_NAME}`} message={message()} />
+}
